# ── LLM ───────────────────────────────────────────────────────────────────────
# Groq free tier — sign up at https://console.groq.com
GROQ_API_KEY=

# Google Gemini — sign up at https://aistudio.google.com
GOOGLE_API_KEY=

# ── App credentials ───────────────────────────────────────────────────────────
APP_USERNAME=admin
APP_PASSWORD=demo1234
CHAINLIT_AUTH_SECRET=  # generate with: chainlit create-secret

# ── Search ────────────────────────────────────────────────────────────────────
# Tavily API key — used to connect to the Tavily MCP server
TAVILY_API_KEY=

# ── Observability (LangSmith) ─────────────────────────────────────────────────
# Free tier — sign up at https://smith.langchain.com
# Remove or set to false to disable tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=business-research-assistant
